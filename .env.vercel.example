# ============================================================
# JOBMASTER AI — Variables d'environnement pour VERCEL
# Copier ces valeurs dans : Vercel Dashboard > Project > Settings > Environment Variables
# Aucune clé ne doit être commitée dans Git.
# ============================================================

# --- OBLIGATOIRE EN PRODUCTION ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=remplacer-avec-une-valeur-aleatoire-longue

# URL publique de votre déploiement Vercel (HTTPS)
NEXT_PUBLIC_APP_URL=https://votre-projet.vercel.app

# --- BASE DE DONNÉES (Supabase recommandé) ---
DATA_BACKEND=supabase
SUPABASE_URL=https://dmwzpbinqxnpprzjfliu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publishable

# --- ADMINISTRATION (sécurité des rôles) ---
# Ne garder QU'UN seul email en production (choisir entre 064 et 104).
ADMIN_EMAILS=johnsalvador064@gmail.com
ADMIN_BOOTSTRAP_SECRET=remplacer-avec-un-secret-aleatoire

# --- CRON (actualisation automatique des offres) ---
# Doit correspondre à l'en-tête Authorization: Bearer <secret>
CRON_SECRET=remplacer-avec-un-secret-aleatoire
AUTO_REFRESH_ENABLED=true
REFRESH_INTERVAL_HOURS=6

# --- OFFRES ---
FRANCE_ONLY=true
INTERNATIONAL_SOURCES=false
LEVER_ENABLED=false

# --- IA (optionnel : sans clé, moteur local déterministe) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- EMAIL — Resend (recommandé, 100 emails/jour gratuits) ---
RESEND_API_KEY=
# Pour envoyer a n'importe quel recruteur : vérifiez votre domaine sur resend.com/domains
# et utilisez une adresse de ce domaine (ex: candidatures@votre-domaine.fr).
# Sinon, onboarding@resend.dev limite l'envoi a votre propre email Resend.
RESEND_FROM=JOBMASTER AI <onboarding@resend.dev>

# --- EMAIL SMTP (alternatif à Resend) ---
# Gmail : port 465 (SSL direct), mot de passe d'application (16 caractères).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JOBMASTER AI <no-reply@votre-domaine.fr>"

# --- STRIPE (optionnel : sans clé, facturation en mode démo) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- FIREBASE (optionnel, alternatif à Supabase) ---
# DATA_BACKEND=firestore  # à la place de supabase
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# IMPORTANT : ne PAS définir COOKIE_INSECURE_LOCAL en production.
# Les cookies Secure sont automatiques dès que NODE_ENV=production (Vercel).
