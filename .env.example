# ============================================================
# JOBMASTER AI — Configuration
# Copier vers .env.local et compléter. Aucune clé n'est requise
# pour démarrer : l'application fonctionne en MODE DÉMO local.
# ============================================================

# Secret de session (OBLIGATOIRE en production). Générer avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# Chemin de la base SQLite (par défaut ./data/jobmaster.db)
DATABASE_PATH=./data/jobmaster.db

# URL publique (pour les liens de réinitialisation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# FIRESTORE (base de données gratuite — projet Firebase)
# 1. Console Firebase > Paramètres du projet > Comptes de service
# 2. Générer une clé, coller le JSON complet dans FIREBASE_SERVICE_ACCOUNT
#    (ou utiliser FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY avec \n)
# 3. DATA_BACKEND=firestore pour activer la persistance Firestore.
# Les valeurs NEXT_PUBLIC_* sont publiques par conception (clé web).
# ============================================================
DATA_BACKEND=sqlite
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ============================================================
# SUPABASE (base PostgreSQL gratuite — RECOMMANDÉ)
# 1. Créer un projet sur https://supabase.com (plan gratuit)
# 2. SQL Editor > New query > coller supabase/migrations/001_jobmaster_init.sql
# 3. Project Settings > API : copier l'URL et la clé service_role
# 4. DATA_BACKEND=supabase
# La clé service_role est UN SECRET : uniquement dans .env.local.
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# ADMINISTRATION — attribution SÉCURISÉE des rôles
# Le rôle admin n'est JAMAIS accordé sur la seule base d'une
# adresse email déclarée par l'utilisateur.
# ============================================================
# Emails candidate-admin (vérification hors-bande obligatoire)
ADMIN_EMAILS=johnsalvador064@gmail.com,johnsalvador104@gmail.com
# Secret à fournir à l'inscription pour revendiquer le rôle admin
ADMIN_BOOTSTRAP_SECRET=changez-moi-aussi

# ============================================================
# OPENAI (analyse CV, lettres, coach, assistant)
# Sans clé : moteur local déterministe, clairement indiqué "démo".
# SECRET : ne JAMAIS mettre la valeur ici. Uniquement dans .env.local
# (ignoré par Git). Si une clé a ete partagee publiquement, REVOQUEZ-la
# dans https://platform.openai.com/api-keys puis générez-en une nouvelle.
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# CONNECTEURS D'OFFRES (API officielles uniquement)
# Aucune clé = offres de démonstration (jeu de données local).
# ============================================================
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
WELCOME_TO_THE_JUNGLE_API_KEY=
# Connecteur carrières Lever (intermittent selon le réseau) : activer explicitement
LEVER_ENABLED=false

# OFFRES FRANCE UNIQUEMENT (défaut : true)
# Filtre strict : villes/pays français, date de publication réelle récente,
# URL d'origine valide. Les offres étrangères sont écartées.
FRANCE_ONLY=true
# Sources internationales (Remotive, Jobicy, RemoteOK, Himalayas, Working Nomads)
# désactivées par défaut car non-françaises. Activer seulement si besoin.
INTERNATIONAL_SOURCES=false

# ACTUALISATION AUTOMATIQUE DES OFFRES
# Secret pour protéger /api/cron/refresh-jobs (Bearer token).
# Brancher ce endpoint sur un cron : Vercel Cron, GitHub Actions ou tâche Windows.
CRON_SECRET=changez-moi-aussi
# Actualisation AUTONOME intégrée au serveur (aucun cron externe nécessaire).
# Le serveur actualise les offres de tous les utilisateurs tout seul.
AUTO_REFRESH_ENABLED=true
REFRESH_INTERVAL_HOURS=6
APEC_API_KEY=

# ============================================================
# EMAIL — Resend (RECOMMANDÉ : 100 emails/jour gratuits)
# Créer un compte sur resend.com > API Keys > Create API Key (clé re_...)
# Avec le domaine de test onboarding@resend.dev, vous ne pouvez envoyer
# qu'à l'email de votre compte Resend. Pour n'importe quel destinataire,
# vérifiez votre propre domaine dans Resend et changez RESEND_FROM.
# ============================================================
RESEND_API_KEY=
RESEND_FROM=JOBMASTER AI <onboarding@resend.dev>

# EMAIL (SMTP) — alternatif si RESEND_API_KEY est vide
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JOBMASTER AI <no-reply@jobmaster.ai>"

# ============================================================
# STRIPE (abonnements) — sans clé : mode facturation démo
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# ENVIRONNEMENT
# ============================================================
NODE_ENV=development
DEMOMODE=true

# Uniquement pour tester localement un build de production en HTTP.
# NE JAMAIS activer sur un déploiement réel (HTTPS).
COOKIE_INSECURE_LOCAL=false
