rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Les CV sont privés : seul le SDK Admin (serveur) peut y accéder.
    match /cvs/{userId}/{fileId}/{filename} {
      allow read, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
